# Set to "true" to shrink the 24h photo-development delay to 5 minutes (testing only).
# .env is gitignored — copy this file to .env and edit locally; start-dev.ps1 spawns the
# backend in a fresh shell that does NOT inherit a session-only $env:DEVELOPMENT_MODE,
# so this file is the reliable way to set it on Windows.
DEVELOPMENT_MODE=false

# Optional: path to the Firebase service account JSON (Console → Project Settings →
# Service accounts → Generate new private key) used for real push notifications.
# Defaults to backend/firebase-service-account.json if unset. Without this file present,
# push notifications fall back to console-log only (see push.service.ts) — the app still
# works fine, no error, just no real push.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
